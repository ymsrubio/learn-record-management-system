// Wrangler's config: tells Cloudflare what this Worker is and what it can reach.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-record-management-system",
  // The file Cloudflare calls for every request.
  "main": "worker/index.ts",
  // Pins which version of the Workers runtime APIs we get, so upgrades never surprise us.
  "compatibility_date": "2026-10-01",
  // Better Auth uses AsyncLocalStorage and Node's crypto, which Workers only offer with this flag.
  "compatibility_flags": ["nodejs_compat"],
  // Runs before every `wrangler deploy`, `versions upload` and `wrangler dev`, so dist/ always
  // exists (Cloudflare's own build never runs `vite build`).
  "build": {
    "command": "npm run build"
  },
  // The built React app (`npm run build` writes dist/). Requests that match a file are served
  // directly. Unknown paths get index.html so React Router can handle them, except /api/*,
  // which always goes to the Worker so a wrong API path stays a 404 and not an HTML page.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 'production' by default. The test setup overrides this to 'test', which is the only
  // environment where the X-Test-Now time hook is accepted.
  "vars": {
    "ENVIRONMENT": "production"
  },
  // A "binding" gives the Worker access to another Cloudflare resource. In code this
  // database appears as `c.env.DB`. No connection string or password: Cloudflare wires it up.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "records-db",
      "database_id": "b7a952cd-d54d-400a-98e7-9bd68842da77",
      // Where Drizzle writes the .sql migration files that Wrangler applies.
      "migrations_dir": "drizzle"
    }
  ],
  // Preview deployments (one per PR branch) do not inherit the settings above, and
  // Wrangler refuses a Preview that binds production resources. So a Preview gets its own
  // empty database. Apply the schema to it by name: wrangler d1 migrations apply records-db-preview --remote
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      // Throwaway: it only signs sessions on the empty preview database, so it is safe to commit.
      // Production's secret is never in this file: `wrangler secret put BETTER_AUTH_SECRET`.
      "BETTER_AUTH_SECRET": "preview-only-not-a-secret-preview-only-not-a-secret"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "records-db-preview",
        "database_id": "12da92fb-02d0-4200-b253-a2baa4ad0fe7",
        "migrations_dir": "drizzle"
      }
    ]
  }
}
